__pycache__/
*.py[cod]
*.nbc
*.nbi
.pytest_cache/
_test_tmp/
.tmp_pytest/
.tmp_test/
*.tmp.*
.pm_configs.json.*.tmp
# Winner-ledger generation locks and last-failure markers are host-local
# mutable state; committing them makes a stale lock travel between machines.
.pm_configs.json.*.lock
.pm_configs.json.generation.last-failure.json

# Local bounded Claude/Codex coordination ledger runtime. The protocol and
# CLI are tracked; hash-chain segments/locks are host-local operational state.
coordination/events*.jsonl
coordination/events*.json
coordination/events*.lock
agent_comms/*.lock
.claude/
logs/
runtime/
data/.cache/
data/.live/
data/*.csv
data/native/
last_actionable_log.json
last_trade_log.json
last_trade_log.json.tmp.*
pm_outputs/
pm_outputs/historical_data/
pm_outputs/trades_*.json
pm_outputs/signal_ledger_*.jsonl
pm_outputs/*_active_run.json
pm_outputs/benchmarks/
pm_outputs/broker_specs_snapshot_*.json
pm_outputs/production_live/
pm_outputs/production_live/feature_cache/
pm_outputs/production_live/oos_evidence/
pm_outputs/production_live/trades_*.json
pm_outputs/production_live/reports/

# Local/private operator configuration. Keep tracked config.json credential-free.
.env
.env.*
config.local.json
config.*.local.json

# Disposable analysis scratch (prospect screens, PBO runs, ad-hoc benchmarks)
pm_outputs/experiments/
.tmp_pytest*/

# Large static reference docs (kept locally, not in git history)
*.pdf

# Test scratch. pytest.ini pins --basetemp here; nothing else should create
# scratch at the repo root. The remaining patterns catch the ad-hoc basetemps
# agents used before that policy existed.
.pytest-scratch/
.agent-test-tmp/
.codex-test-tmp*/
.codex-runfailure-*/
.root-test-tmp-*/
.pytest-tmp*/
.pytest_tmp_*/
.test-tmp*/
.tmp-terminal-*/
.hostile-*/
.final-gap-calendar-*/
.tmp/
pytest_anchor_plan_*/
pytest_reuse_*/

# Production run artifacts: large, regenerable, and content-addressed.
fxpm-production-runs/

# Supervisor lock/owner state is host-local, never shared.
.fxpm-production-generation-supervisor/

# Stray shell-redirect and crash residue. These are accidents, not outputs;
# the patterns keep them from being committed if they recur.
=*
fail
*.stackdump
.rev_diff_tmp.txt
canon_*.log
pm_dashboard.html
