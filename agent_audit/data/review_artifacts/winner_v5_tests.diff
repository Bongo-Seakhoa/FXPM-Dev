+def test_cyclic_deep_wide_and_huge_inputs_are_total_and_bounded() -> None:
+    _, trust, _ = _signed_request()
+    cyclic: dict[str, Any] = {}
+    cyclic["self"] = cyclic
+    deep: dict[str, Any] = {}
+    cursor = deep
+    for _ in range(40):
+        child: dict[str, Any] = {}
+        cursor["next"] = child
+        cursor = child
+    wide = {str(index): index for index in range(winner.MAX_CONTAINER_ITEMS + 1)}
+    huge = {"blob": "x" * (winner.MAX_STRING_CHARS + 1)}
+    tracemalloc.start()
+    try:
+        for hostile in (cyclic, deep, wide, huge):
+            decision = winner.evaluate_historical_cell_winner(hostile, trust)
+            assert decision.status == "REJECTED"
+            assert not winner.verify_historical_cell_winner_decision(decision, trust)
+        _, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+    assert peak < 80 * 1024 * 1024
+
