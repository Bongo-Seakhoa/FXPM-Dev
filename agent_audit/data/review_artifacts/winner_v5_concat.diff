+def _verify_envelope(
+    envelope: Any,
+    *,
+    expected_key_id: str,
+    public_key: bytes,
+    domain: bytes,
+    schema_code: str,
+) -> tuple[dict[str, Any], str, str]:
+    value = _exact_dict(envelope, _ENVELOPE_KEYS, schema_code)
+    if type(value["key_id"]) is not str or value["key_id"] != expected_key_id:
+        raise _ContractError(schema_code + "_KEY_ID_MISMATCH")
+    payload = value["payload"]
+    if type(payload) is not dict:
+        raise _ContractError(schema_code + "_PAYLOAD_TYPE_INVALID")
+    payload_bytes = _canonical_bytes(payload)
+    payload_sha = _sha256_bytes(payload_bytes)
+    if (
+        type(value["payload_sha256"]) is not str
+        or value["payload_sha256"] != payload_sha
+    ):
+        raise _ContractError(schema_code + "_PAYLOAD_HASH_MISMATCH")
+    signature_text = value["signature_base64"]
+    if type(signature_text) is not str or len(signature_text) != 88:
+        raise _ContractError(schema_code + "_SIGNATURE_INVALID")
+    try:
+        signature = b64decode(signature_text, validate=True)
+    except (TypeError, ValueError) as exc:
+        raise _ContractError(schema_code + "_SIGNATURE_INVALID") from exc
+    if len(signature) != 64 or len(public_key) != 32 or Ed25519PublicKey is None:
+        raise _ContractError(schema_code + "_SIGNATURE_INVALID")
+    try:
+        Ed25519PublicKey.from_public_bytes(public_key).verify(
+            signature, domain + payload_bytes
+        )
+    except (InvalidSignature, TypeError, ValueError) as exc:
+        raise _ContractError(schema_code + "_SIGNATURE_INVALID") from exc
+    return payload, payload_sha, _sha256_json(value)
+
