+@dataclass(frozen=True, slots=True)
+class WinnerSelectionTrustBundle:
+    """Public keys that authenticate the three historical input ledgers."""
+
+    precommitment_key_id: str
+    precommitment_public_key: bytes
+    attempt_key_id: str
+    attempt_public_key: bytes
+    evidence_key_id: str
+    evidence_public_key: bytes
+    trust_bundle_sha256: str
+
+
+def _trust_payload(
+    precommitment_key_id: str,
+    precommitment_public_key: bytes,
+    attempt_key_id: str,
+    attempt_public_key: bytes,
+    evidence_key_id: str,
+    evidence_public_key: bytes,
+) -> dict[str, Any]:
+    from base64 import b64encode
+
+    return {
+        "contract": "fxpm.winner-selection-historical-trust-bundle.v2",
+        "precommitment": {
+            "key_id": precommitment_key_id,
+            "public_key_base64": b64encode(precommitment_public_key).decode("ascii"),
+        },
+        "attempt_ledger": {
+            "key_id": attempt_key_id,
+            "public_key_base64": b64encode(attempt_public_key).decode("ascii"),
+        },
+        "evidence_ledger": {
+            "key_id": evidence_key_id,
+            "public_key_base64": b64encode(evidence_public_key).decode("ascii"),
+        },
+    }
+
+
+def create_trust_bundle(
+    *,
+    precommitment_key_id: Any,
+    precommitment_public_key_base64: Any,
+    attempt_key_id: Any,
+    attempt_public_key_base64: Any,
+    evidence_key_id: Any,
+    evidence_public_key_base64: Any,
+    current_refit_key_id: Any = None,
+    current_refit_public_key_base64: Any = None,
+) -> WinnerSelectionTrustBundle | None:
+    """Build historical public trust; legacy refit arguments fail closed."""
+
+    try:
+        if (
+            current_refit_key_id is not None
+            or current_refit_public_key_base64 is not None
+        ):
+            return None
+        ids = (precommitment_key_id, attempt_key_id, evidence_key_id)
+        texts = (
+            precommitment_public_key_base64,
+            attempt_public_key_base64,
+            evidence_public_key_base64,
+        )
+        if any(
+            type(value) is not str or _SAFE_ID.fullmatch(value) is None for value in ids
+        ):
+            return None
+        if len(set(ids)) != 3:
+            return None
+        if any(type(value) is not str or len(value) != 44 for value in texts):
+            return None
+        try:
+            keys = tuple(b64decode(value, validate=True) for value in texts)
+        except (TypeError, ValueError):
+            return None
+        if any(len(value) != 32 for value in keys) or len(set(keys)) != 3:
+            return None
+        payload = _trust_payload(ids[0], keys[0], ids[1], keys[1], ids[2], keys[2])
+        return WinnerSelectionTrustBundle(
+            ids[0],
+            keys[0],
+            ids[1],
+            keys[1],
+            ids[2],
+            keys[2],
+            _sha256_json(payload),
+        )
+    except Exception:
+        return None
+
+
+def _trust_bundle_valid(bundle: Any) -> bool:
+    if type(bundle) is not WinnerSelectionTrustBundle:
+        return False
+    fields = (
+        (bundle.precommitment_key_id, bundle.precommitment_public_key),
+        (bundle.attempt_key_id, bundle.attempt_public_key),
+        (bundle.evidence_key_id, bundle.evidence_public_key),
+    )
+    if any(
+        type(key_id) is not str
+        or _SAFE_ID.fullmatch(key_id) is None
+        or type(key) is not bytes
+        or len(key) != 32
+        for key_id, key in fields
+    ):
+        return False
+    if (
+        len({key_id for key_id, _ in fields}) != 3
+        or len({key for _, key in fields}) != 3
+    ):
+        return False
+    expected = _sha256_json(
+        _trust_payload(
+            fields[0][0],
+            fields[0][1],
+            fields[1][0],
+            fields[1][1],
+            fields[2][0],
+            fields[2][1],
+        )
+    )
+    return (
+        type(bundle.trust_bundle_sha256) is str
+        and bundle.trust_bundle_sha256 == expected
+    )
+
